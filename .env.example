# Copy to .env and fill in. Never commit .env.

# Which model API to use: anthropic (default) or groq.
LLM_PROVIDER=anthropic

# Anthropic (Claude). Needs prepaid API credit.
ANTHROPIC_API_KEY=your-key-here
# Optional model override.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Groq (has a free plan). Key from console.groq.com.
GROQ_API_KEY=your-groq-key-here
# Optional model override (any Groq model with tool use).
GROQ_MODEL=openai/gpt-oss-120b

# Optional: default WordPress site to read (any public WordPress site works).
WP_SITE_URL=https://example.com

# Optional: Figma. A personal access token with read-only access to file content
# (Figma > Settings > Security > Personal access tokens), and a default design file.
FIGMA_TOKEN=your-figma-token-here
FIGMA_FILE=https://www.figma.com/design/<KEY>/<name>
